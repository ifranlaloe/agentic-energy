{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run preview*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run format*)",
      "Bash(npm test*)",
      "Bash(npm audit*)",
      "Bash(find src*)",
      "Bash(node .claude/skills/*)"
    ],
    "deny": [
      "Bash(git *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.mjs"
          }
        ]
      }
    ]
  }
}
